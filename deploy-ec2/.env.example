# CSI St. Mark's Portal — EC2 demo configuration.
#
#   cp .env.example .env      then edit .env
#
# `.env` is read by `docker compose` from this directory and is git-ignored.
# Put no real secrets in THIS file.
#
# Everything below is optional: the container generates what it needs on first
# boot and stores it in the `portal-data` volume. The values worth setting for
# this demo are marked REQUIRED-ISH.

# ---------------------------------------------------------- REQUIRED-ISH ---

# The origin browsers use to reach the Portal. Stored inside media URLs, and
# handed to the public website. Scheme and host, no trailing slash; include the
# port because visitors do.
PUBLIC_URL=http://54.252.189.117:8080

# Browser origins allowed to call the API. Comma-separated, exact match.
# The public website first, then the Portal itself.
CORS_ORIGINS=http://54.252.189.117:3000,http://54.252.189.117:8080

# ---------------------------------------------------------------- optional --

# Session signing keys. Leave EMPTY and the container generates two different
# 48-byte values on first boot and keeps them in the portal-data volume, which
# is the right answer for a demo. Set them only to survive a volume reset.
# Two DIFFERENT values, 32+ characters each:
#   openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# The administrator account, created ONCE and only if the database has none.
# The image's snapshot already contains the church's accounts, so on a normal
# boot these are unused. Set them to have a known login on a reset volume.
# Minimum 12 characters; change it in the CMS afterwards.
#
# Leave the email as it is or set a real one, but do not blank it: the compose
# file supplies this same default, because the API reads it with `??` and an
# empty string is not undefined.
SEED_ADMIN_EMAIL=admin@csistmarksmadipakkam.org
SEED_ADMIN_PASSWORD=

# Refreshes the public website the moment the CMS publishes. The website runs
# on the EC2 host, not in Compose, so `host.docker.internal` is how the
# container reaches it — resolved by the `extra_hosts` entry in the compose
# file. The secret must be IDENTICAL to REVALIDATE_SECRET in
# WebsiteRT/.env.local. Leave the secret empty and publishing still works; the
# site just picks changes up on its own schedule, within ~5 minutes.
WEBSITE_REVALIDATE_URL=http://host.docker.internal:3000/api/revalidate
WEBSITE_REVALIDATE_SECRET=

# MongoDB's WiredTiger cache, in GB. 0.25 is the floor MongoDB accepts and what
# the entrypoint pins by default — right for a few hundred documents on a 4 GiB
# instance. Raise it only if the dataset grows a great deal.
MONGO_CACHE_GB=0.25

# --------------------------------------------------------------------------
# Deliberately NOT set here
#
#   MONGODB_URI   The image runs its own MongoDB on 127.0.0.1:27017 inside the
#                 container. Set this only to point at an external database —
#                 the bundled one is then never started.
#   PORT          Fixed at 8080 for this demo, in the compose file.
#   SPLIT_PORTS   Would publish the API and CMS on 4000/3001 separately. This
#                 demo serves both behind the single 8080 port.
#   ENABLE_API_DOCS   Publishes Swagger at /docs, which maps every admin route
#                 for anyone who looks. Off in production by default.
#   CORS_ALLOW_PRIVATE_NETWORK   Off in production. The API refuses to start
#                 with it on, because it admits any private-network origin with
#                 credentials.
# --------------------------------------------------------------------------
