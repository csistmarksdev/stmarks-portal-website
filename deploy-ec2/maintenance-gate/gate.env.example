# Optional settings for the maintenance gate. Copy to gate.env beside gate.mjs:
#
#   cp deploy-ec2/maintenance-gate/gate.env.example deploy-ec2/maintenance-gate/gate.env
#   sudo systemctl restart csistmc-maintenance-gate
#
# The essentials (ports, the website and Portal addresses) are already set in
# csistmc-maintenance-gate.service.

# Lets the church check the real website while it is in maintenance: open
#   http://<site>/?gate-preview=<this value>
# once in a browser; that browser then sees the site for 12 hours. Leave empty
# to disable. Use a long random value:  openssl rand -hex 16
GATE_BYPASS_TOKEN=

# Name shown at the top of the maintenance notice.
# SITE_NAME=St. Mark's Church, CSI Madipakkam

# How long (ms) the gate reuses the Portal's answer before asking again.
# STATUS_TTL_MS=5000
