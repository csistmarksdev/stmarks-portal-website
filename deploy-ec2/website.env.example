# CSI St. Mark's public website (WebsiteRT) — EC2 demo configuration.
#
# Copy to the website's own directory, NOT this one:
#
#   cp deploy-ec2/website.env.example WebsiteRT/.env.local
#
# `next build` and `next start` both load `.env.local` from the website's
# working directory automatically. `.env*` is git-ignored there.
#
# NEXT_PUBLIC_* values are inlined into the client JavaScript at BUILD time, so
# they are a property of the build, not of the running process: change one and
# you must `npm run build` again. The server-only values below are read at
# runtime and a restart is enough.

# ---------------------------------------------------------------- required --

# Where the site finds the Portal API. Include the /v1 prefix.
#
# With this UNSET every service silently falls back to src/data/*.mock.ts and
# the site renders last year's sample content instead of the church's — so an
# unconfigured deployment looks like it works. Set it.
#
# It also drives next.config.ts: `images.remotePatterns` is derived from this
# host so next/image will optimise /uploads/** served by the Portal.
NEXT_PUBLIC_API_URL=http://54.252.189.117:8080/v1

# The site's own canonical origin, used for metadata and absolute links.
NEXT_PUBLIC_SITE_URL=http://54.252.189.117:3000

# ------------------------------------------------------------- recommended --

# Shared secret the Portal presents when telling the site to drop cached
# content after a publish. Server-only, read at runtime.
#
# Must be IDENTICAL to WEBSITE_REVALIDATE_SECRET in deploy-ec2/.env. With it
# unset, /api/revalidate answers 503 and the site refreshes on its own
# schedule instead, within ~5 minutes.
#   openssl rand -base64 32
REVALIDATE_SECRET=

# --------------------------------------------------------------------------
# Not needed for serving the site
#
#   PORTAL_API_URL, PORTAL_ADMIN_EMAIL, PORTAL_ADMIN_PASSWORD are read only by
#   the one-off maintenance scripts in WebsiteRT/scripts/ (migrate-to-portal,
#   demo-videos). Leave them out of a deployment.
# --------------------------------------------------------------------------
