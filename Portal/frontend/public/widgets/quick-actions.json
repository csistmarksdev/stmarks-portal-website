{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    { "type": "TextBlock", "text": "${title}", "weight": "Bolder", "size": "Medium", "wrap": true },
    { "type": "TextBlock", "text": "${subtitle}", "isSubtle": true, "wrap": true, "spacing": "Small" }
  ],
  "actions": [
    { "type": "Action.Execute", "title": "New announcement", "verb": "/announcements/new" },
    { "type": "Action.Execute", "title": "New event", "verb": "/events/new" },
    { "type": "Action.Execute", "title": "Messages", "verb": "/contact-messages" },
    { "type": "Action.Execute", "title": "Backup", "verb": "/backup" }
  ]
}
