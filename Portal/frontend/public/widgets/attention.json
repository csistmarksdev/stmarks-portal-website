{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    { "type": "TextBlock", "text": "Needs attention", "weight": "Bolder", "size": "Medium" },
    { "type": "TextBlock", "text": "${headline}", "wrap": true, "spacing": "Small" },
    {
      "type": "FactSet",
      "$when": "${count(facts) > 0}",
      "facts": [{ "$data": "${facts}", "title": "${title}", "value": "${value}" }]
    },
    { "type": "TextBlock", "text": "${updated}", "isSubtle": true, "size": "Small", "wrap": true, "$when": "${updated != ''}" }
  ],
  "actions": [
    { "type": "Action.Execute", "title": "Open dashboard", "verb": "/dashboard" },
    { "type": "Action.Execute", "title": "Messages", "verb": "/contact-messages" }
  ]
}
