# Where the CMS finds the API.
#
# Leave this UNSET for local and same-network use. The app then derives the API
# origin from whatever address the page was opened on — http://localhost:3001
# calls localhost:4000, and http://192.168.1.5:3001 calls 192.168.1.5:4000 —
# so one build works everywhere without a rebuild.
#
# Setting it pins every device to that one address, which breaks access from
# other machines. Only set it when the API genuinely lives on a different host
# from the CMS, e.g. in production:
# NEXT_PUBLIC_API_URL=https://api.csistmarksmadipakkam.org/v1

# Only needed if the API runs on a non-default port or prefix.
# NEXT_PUBLIC_API_PORT=4000
# NEXT_PUBLIC_API_PREFIX=v1
