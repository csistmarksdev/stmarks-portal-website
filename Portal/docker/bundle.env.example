# CSI St. Mark's Portal — configuration
#
# Copy this file to `.env` beside `start.mjs` and fill it in, or set the same
# names in your hosting platform's dashboard. Real environment variables always
# take precedence over this file.
#
# Anything commented out uses the default shown.

# ---------------------------------------------------------------- required --

# The database. Include credentials and authSource if your server requires them.
MONGODB_URI=mongodb://user:password@127.0.0.1:27017/csistmc-portal?authSource=csistmc-portal

# The public origin of THIS deployment — scheme and host, no trailing slash and
# no path. It is stored inside image URLs in the database, so it must match the
# address browsers actually use. Include the port only if visitors do.
#
#   behind a domain :  https://portal.example.org
#   plain VM, port 8080 :  http://203.0.113.10:8080
#
# Not sure yet? Start once, note the address, set it, and restart — stored image
# URLs are repointed automatically.
PUBLIC_URL=http://localhost:8080

# Browser origins allowed to call the API: the public website, and this Portal
# itself if you reach it by a different name. Comma-separated, exact match, so
# include the `www.` form if you serve it.
CORS_ORIGINS=https://csistmarksmadipakkam.org,https://www.csistmarksmadipakkam.org

# Session signing keys. Generate two DIFFERENT values, 32+ characters each:
#   openssl rand -base64 48
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# The administrator account, created ONCE on first boot.
# Minimum 12 characters. Change the password in the CMS afterwards — editing it
# here later has no effect, because the account already exists.
SEED_ADMIN_EMAIL=admin@csistmarksmadipakkam.org
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Portal Administrator

# Turns on the startup safety checks. Leave this set for any real deployment.
NODE_ENV=production

# ------------------------------------------------------------- recommended --

# Lets the CMS refresh the public website the moment something is published.
# Without them the site picks up changes on its own schedule, within ~5 minutes.
# WEBSITE_REVALIDATE_SECRET must be identical to REVALIDATE_SECRET on the website.
WEBSITE_REVALIDATE_URL=
WEBSITE_REVALIDATE_SECRET=

# ---------------------------------------------------------------- optional --

# The PUBLIC port — the one visitors reach. Most hosting platforms set this for
# you; on a plain VM, choose it here. The CMS and the API are both served from
# it: `/v1` and `/uploads` go to the API, everything else to the CMS.
# PORT=8080

# Internal ports, used only between the router and the two apps. They must
# differ from PORT and from each other. Change only if something else on the
# machine already uses them.
# API_PORT=4000
# CMS_PORT=3001

# Expose the API and CMS on their own ports instead of routing through one.
# SPLIT_PORTS=false

# Upload ceilings, in megabytes.
# MAX_UPLOAD_MB=15
# MAX_VIDEO_UPLOAD_MB=200

# Where uploaded media is written, relative to `backend/`. Point this at
# persistent storage if your platform replaces the app folder on each deploy —
# otherwise every uploaded photograph is lost on the next release.
# UPLOAD_DIR=uploads

# Session lifetimes.
# JWT_ACCESS_EXPIRES=15m
# JWT_REFRESH_EXPIRES=7d

# Publishes the API documentation at /docs. Off in production by default,
# because it maps every administrative route for anyone who looks.
# ENABLE_API_DOCS=true

# Trusts any private-network origin, with credentials. Convenient on an office
# LAN, unsafe on a public server. Off in production unless set here.
# CORS_ALLOW_PRIVATE_NETWORK=false
