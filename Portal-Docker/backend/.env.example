# Server
PORT=4000
API_PREFIX=v1
# Public origin of this API — used to build absolute media URLs, which are
# STORED inside content records. Leave unset and it defaults to this machine's
# LAN address so uploads are reachable from other devices; set it explicitly to
# the canonical origin before going to production.
# PUBLIC_URL=http://10.147.18.1:4000
# Comma-separated origins allowed by CORS. Use "*" to allow any origin.
# Devices on the same network (localhost, 10.x, 192.168.x, 172.16-31.x, *.local)
# are allowed on any port regardless of this list — set
# CORS_ALLOW_PRIVATE_NETWORK=false to require an explicit entry instead.
CORS_ORIGINS=http://localhost:3001,http://localhost:3000
CORS_ALLOW_PRIVATE_NETWORK=true

# Database
MONGODB_URI=mongodb://localhost:27017/csistmc-portal

# Auth
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES=7d

# Seed admin (used by `npm run seed`)
SEED_ADMIN_EMAIL=admin@csistmarksmadipakkam.org
# Used once, on first boot, to create the administrator. The API refuses to
# start in production while this is unset or left as an example value.
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Portal Administrator

# Set to `true` to have `npm run seed` also create a sample event and
# announcement, so list pages are not empty while developing. Leave unset on a
# real installation: those rows publish immediately and appear on the public
# site alongside the church's own content.
# SEED_DEMO_CONTENT=true

# Media
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=15
# Videos are much larger than photos, so they get their own ceiling.
MAX_VIDEO_UPLOAD_MB=200

# --------------------------------------------------------------------------
# Production
#
# With NODE_ENV=production the API validates its own configuration at startup
# and refuses to boot on the development defaults above — unset JWT secrets,
# a localhost PUBLIC_URL, localhost CORS origins. It lists every problem at
# once. Leave NODE_ENV unset for local development.
# --------------------------------------------------------------------------

# Trust any private-network origin (convenient on a LAN, unsafe on a server).
# Defaults: on in development, OFF in production. Set explicitly to override.
# CORS_ALLOW_PRIVATE_NETWORK=false

# Swagger at /docs is on in development and off in production, because it maps
# every admin route for anyone probing. Set true to re-enable deliberately.
# ENABLE_API_DOCS=true

# Website ISR revalidation webhook — leave empty during standalone phase.
# When integration begins: https://csistmarksmadipakkam.org/api/revalidate
WEBSITE_REVALIDATE_URL=http://localhost:3000/api/revalidate
WEBSITE_REVALIDATE_SECRET=local-dev-revalidate-secret
