# CSI St. Mark's Portal — the whole installation in one image.
#
#   docker build -t csistmarkscmsportal .
#   docker run -d -p 8080:8080 -v portal-data:/data csistmarkscmsportal
#
# That is the entire deployment. The image carries the API, the admin CMS, a
# MongoDB server, and a snapshot of the church's real content, media and
# accounts — so it comes up as a working portal with no database to provision
# and nothing to configure. Point `MONGODB_URI` at a managed database and the
# bundled one is never started.
#
# Everything is compiled here, once. The container never builds on boot; see
# `docker/entrypoint.mjs` for why that matters on a small host.
#
# Base images
# -----------
# glibc on both sides, and that part is not negotiable. `sharp` and Next's SWC
# compiler are native modules resolved against the C library at install time, so
# building on Alpine (musl) and running on a glibc distribution produces an image
# that builds cleanly and then fails at runtime on the first image upload — the
# two libraries are not interchangeable and npm cannot tell they were swapped.
#
# The build stages are Debian (`node:24-bookworm`), because that is what the
# official Node images actually are — there is no Ubuntu-based `node:` tag, and
# assuming one produces a Dockerfile that cannot resolve its own base image.
# Not the `-slim` variant: a dependency that has to compile from source needs
# python3 and a compiler, and this stage is discarded anyway so its size is
# irrelevant.
#
# The runtime is `ubuntu:24.04`, chosen over Debian because MongoDB publishes
# both linux/amd64 and linux/arm64 packages for Ubuntu and only amd64 for
# Debian — so this is what lets one Dockerfile serve a ZimaBoard, an AWS
# Graviton instance and an Apple Silicon laptop.
#
# Crossing from Debian to Ubuntu is safe in the direction it is done here.
# glibc is backwards compatible, so a binary linked against Debian 12's 2.36
# runs on Ubuntu 24.04's 2.39; the reverse would not. Node itself is installed
# from the official tarball rather than copied across, because those are built
# to target glibc 2.28 and are the canonical way to put Node on any distribution
# — no assumption about either base image's release is involved.
#
# Not the official `mongo:8` image, for one specific reason: it declares
# `VOLUME /data/db`. That declaration is inherited and cannot be undone, so
# every `docker run` would create an anonymous volume mounted *over* `/data/db`
# — shadowing the very path inside a `-v portal-data:/data` mount that the
# database writes to. The data would look persisted, live somewhere else, and
# vanish on `docker rm`.

# ---------------------------------------------------------------- build ----
FROM node:24-bookworm AS build
WORKDIR /app

ENV NEXT_TELEMETRY_DISABLED=1

# The exact Node version this image was built with, recorded for the runtime
# stage to install. Deriving it beats hardcoding a version number in two places
# and watching them drift: the runtime is then guaranteed to run the same Node
# the application was compiled and dependency-resolved against.
RUN node --version | sed 's/^v//' > /node-version

# Manifests first: this layer is cached until a dependency actually changes,
# which is the difference between a 20-second rebuild and a 4-minute one.
COPY package.json package-lock.json ./
COPY shared/package.json shared/
COPY backend/package.json backend/
COPY frontend/package.json frontend/
RUN npm ci

COPY shared shared
COPY backend backend
COPY frontend frontend

# Baked into the CMS bundle at build time, because `NEXT_PUBLIC_*` is inlined
# into the client JavaScript and cannot be changed later. It tells the browser
# that the API answers on the page's own origin under `/v1`, which is exactly
# what the entrypoint's router arranges. Without it the CMS appends `:4000` to
# whatever domain it was loaded from and every request fails.
ENV NEXT_PUBLIC_API_SAME_ORIGIN=true

# Serve uploaded images as they are, rather than through Next's optimiser.
#
# Optimising needs CPU on every cold image and a writable `.next/cache` — which
# the container does not reliably have, because platforms that impose their own
# `runAsUser` leave the build's directories readable but not writable. The
# failure would appear as broken images on an otherwise healthy portal.
#
# Nothing is lost: every upload already has a WebP thumbnail and a blur
# placeholder generated by `sharp` at upload time, which is what the CMS
# displays. This serves bytes that already exist.
ENV NEXT_PUBLIC_UNOPTIMIZED_IMAGES=true

RUN npm run build -w @portal/shared \
 && npm run build -w @portal/backend \
 && npm run build -w @portal/frontend

# ------------------------------------------------------- runtime deps ------
# Production dependencies for the API, installed in isolation.
#
# `@portal/shared` is stripped first: it is a workspace package that does not
# exist on the public registry, so leaving it in the manifest makes `npm install`
# fail with a 404. It is copied in from the build stage instead.
FROM node:24-bookworm AS deps
WORKDIR /deps
COPY backend/package.json ./package.json
RUN node -e "const p=require('./package.json'); delete p.dependencies['@portal/shared']; \
             require('fs').writeFileSync('package.json', JSON.stringify({name:p.name,version:p.version,private:true,dependencies:p.dependencies},null,2))" \
 && npm install --omit=dev --no-audit --no-fund

# -------------------------------------------------------------- runtime ----
FROM ubuntu:24.04 AS runtime
WORKDIR /app

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=8080 \
    STATE_DIR=/data \
    DEBIAN_FRONTEND=noninteractive

# The exact Node version the application was built against.
COPY --from=build /node-version /tmp/node-version

# MongoDB and Node, in one layer.
#
# `mongodb-org-server` is just `mongod` — the shell and the import/export tools
# are another 150 MB of things nothing in this image invokes.
#
# Node comes from the official tarball, which targets glibc 2.28 and so does not
# care which Ubuntu this is, and only the `node` binary is extracted: npm, the
# headers and the bundled docs are build-time tools with no place in a runtime
# image.
#
# One `RUN`, because `curl`, `gnupg` and `xz-utils` are needed by both halves and
# must be gone by the time the layer is committed. Removing them in a *later*
# layer would leave them in the image regardless — a deleted file in an upper
# layer still ships the bytes underneath it.
ARG MONGO_MAJOR=8.0
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends ca-certificates curl gnupg xz-utils; \
    \
    curl -fsSL "https://pgp.mongodb.com/server-${MONGO_MAJOR}.asc" \
        | gpg --dearmor -o /usr/share/keyrings/mongodb.gpg; \
    echo "deb [ signed-by=/usr/share/keyrings/mongodb.gpg ] https://repo.mongodb.org/apt/ubuntu noble/mongodb-org/${MONGO_MAJOR} multiverse" \
        > /etc/apt/sources.list.d/mongodb.list; \
    apt-get update; \
    apt-get install -y --no-install-recommends mongodb-org-server; \
    \
    NODE_VERSION="$(cat /tmp/node-version)"; \
    case "$(dpkg --print-architecture)" in \
        amd64) node_arch=x64 ;; \
        arm64) node_arch=arm64 ;; \
        *) echo "unsupported architecture: $(dpkg --print-architecture)" >&2; exit 1 ;; \
    esac; \
    tarball="node-v${NODE_VERSION}-linux-${node_arch}"; \
    curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/${tarball}.tar.xz" -o /tmp/node.tar.xz; \
    tar -xJf /tmp/node.tar.xz -C /usr/local --strip-components=1 --no-same-owner "${tarball}/bin/node"; \
    rm /tmp/node.tar.xz /tmp/node-version; \
    \
    apt-get purge -y --auto-remove curl gnupg xz-utils; \
    rm -rf /var/lib/apt/lists/*; \
    mongod --version | head -1; \
    node --version

# The unprivileged account, created *before* anything is copied so that every
# COPY can set its ownership directly.
#
# Group 0 rather than a group of its own: that is what lets platforms which
# impose an arbitrary `runAsUser` — OpenShift, and any Kubernetes with a
# restricted security context — still read the application. They pick the UID;
# they always put it in group 0.
RUN useradd --system --uid 10001 --gid 0 --home-dir /app --shell /usr/sbin/nologin portal

# `--chown` on each COPY rather than one `chown -R` at the end. A recursive
# chown rewrites every file it touches, and because layers are copy-on-write
# that writes a second full copy of the application into the final layer —
# roughly doubling the image for a metadata change. Setting ownership as the
# files arrive costs nothing.

# The API: compiled output plus production dependencies.
COPY --from=build --chown=10001:0  /app/backend/dist         backend/dist
COPY --from=deps  --chown=10001:0  /deps/node_modules        backend/node_modules
COPY --from=build --chown=10001:0  /app/shared/dist          backend/node_modules/@portal/shared/dist
COPY --from=build --chown=10001:0  /app/shared/package.json  backend/node_modules/@portal/shared/package.json

# The CMS: Next.js standalone server. `static` and `public` are copied
# separately because Next leaves them out of the trace — they are read from
# disk, never imported, so nothing references them and the CMS would otherwise
# boot and serve pages with no CSS or JavaScript.
COPY --from=build --chown=10001:0  /app/frontend/.next/standalone/frontend      frontend
COPY --from=build --chown=10001:0  /app/frontend/.next/standalone/node_modules  node_modules
COPY --from=build --chown=10001:0  /app/frontend/.next/static                   frontend/.next/static
COPY --from=build --chown=10001:0  /app/frontend/public                         frontend/public

# The installation itself: every document and every uploaded file, captured
# from the live database by `scripts/capture-live-data.mjs`.
COPY --chown=10001:0 snapshot snapshot

COPY --chown=10001:0 docker/entrypoint.mjs        start.mjs
COPY --chown=10001:0 docker/restore-snapshot.mjs  backend/restore-snapshot.mjs

# The Website contract test, carried inside the image so any deployment can
# verify itself with nothing installed on the host:
#
#   docker exec portal node /app/check-website-api.mjs http://127.0.0.1:8080
#
# It has no dependencies and is a few kilobytes. Shipping it means the answer to
# "is this deployment actually serving the Website correctly" is available on the
# machine where the question is being asked, rather than needing a checkout.
COPY --chown=10001:0 scripts/check-website-api.mjs check-website-api.mjs
# Deliberately not `COPY --chmod`: that option requires BuildKit, and this image
# should build under the classic builder too. `chmod` in the next layer costs
# nothing on a 2 KB file.
COPY docker/launch.sh /usr/local/bin/launch.sh

# Only the writable paths need group-write, and both are empty here — so this
# stays a metadata-only layer of two directories rather than a copy of the app.
RUN chmod 0755 /usr/local/bin/launch.sh \
 && mkdir -p /data/db /app/backend/uploads \
 && chown -R 10001:0 /data /app/backend/uploads \
 && chmod -R g+rwX   /data /app/backend/uploads

# Fail the build, not the deployment, if the pieces the entrypoint depends on
# are not actually here. Each of these has a plausible way of going missing —
# a transitive dependency dropped upstream, a base image slimmed down — and
# each would otherwise surface as a container that starts and then dies.
RUN set -eux; \
    cd /app/backend; \
    node -e "require.resolve('mongodb'); require.resolve('bson')"; \
    cd /app; \
    test -f /app/backend/dist/main.js; \
    test -f /app/backend/dist/seed/initialize.js; \
    test -f /app/frontend/server.js; \
    test -d /app/frontend/.next/static; \
    test -d /app/snapshot/db; \
    command -v mongod; \
    command -v setpriv || command -v gosu; \
    echo "runtime image contents verified"

# The database, generated secrets and uploaded media. Declared so that a plain
# `docker run` with no `-v` still keeps them out of the container's writable
# layer, and so hosts that provision storage automatically know where it goes.
VOLUME ["/data", "/app/backend/uploads"]

# One port. The router inside serves the CMS and proxies the API under it, so
# there is a single URL, a single origin and no CORS between the two halves.
EXPOSE 8080

# `start-period` is generous because the first boot restores the snapshot before
# anything listens. Marking a container unhealthy while it is doing exactly what
# it was told to do causes platforms to kill and retry it, forever.
HEALTHCHECK --interval=30s --timeout=5s --start-period=120s --retries=5 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||8080)+'/'+(process.env.API_PREFIX||'v1')+'/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

# Started as root so ownership of a freshly mounted volume can be corrected,
# then dropped to `portal`. See `docker/launch.sh`.
ENTRYPOINT ["/usr/local/bin/launch.sh"]
CMD ["node", "/app/start.mjs"]
