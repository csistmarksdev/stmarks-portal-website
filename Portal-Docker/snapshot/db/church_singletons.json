  {
    "_id": {
      "$oid": "6a622da1ad952d26e9d58ebe"
    },
    "key": "weekly-verse",
    "data": {
      "reference": {
        "en": "John 3:16",
        "ta": "யோவான் 3:16"
      },
      "text": {
        "en": "For God so loved the world, that he gave his only begotten Son, that whosoever believeth in him should not perish, but have everlasting life.",
        "ta": "தேவன், தம்மின் விசுவாசமாய் இருக்கிற எவனும் கெட்டுப்போகாமல் நித்திய ஜீவனைப் அடையும்படிக்கு, தம்முடைய ஒரேபேறான குமாரனைத் தந்தருளி, இவ்வளவாய் உலகத்தில் அன்பு கூர்ந்தார்."
      },
      "weekOf": "2026-07-26"
    },
